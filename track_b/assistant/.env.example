# Application image and host ports
APP_IMAGE=wk16-agentic-ai:local
ENVIRONMENT=production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8501
# Set this whenever the API is reachable beyond the local machine.
APP_API_KEY=
BACKEND_PORT=8000
UI_PORT=8501
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
REDIS_PORT=6379
BACKEND_URL=http://backend:8000

# Primary provider (OpenAI-compatible cloud endpoint by default)
PRIMARY_PROVIDER=openai
PRIMARY_MODEL=gpt-4.1-mini
PRIMARY_BASE_URL=https://api.openai.com/v1
PRIMARY_API_KEY=

# Fallback is disabled by default. Uncomment it together with COMPOSE_PROFILES below.
FALLBACK_PROVIDER=
FALLBACK_MODEL=local-model
FALLBACK_BASE_URL=http://vllm:8000/v1
FALLBACK_API_KEY=local-not-used

# Retrieval and embeddings
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VECTOR_STORE=qdrant
COLLECTION_NAME=assistant_documents
QDRANT_URL=http://qdrant:6333

# Reliability and generation controls
REDIS_URL=redis://redis:6379/0
REDIS_TIMEOUT_SECONDS=2
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
BATCH_CONCURRENCY=4
CACHE_TTL_SECONDS=300
MAX_TOKENS=700
PROVIDER_TIMEOUT_SECONDS=20
PROVIDER_TOTAL_TIMEOUT_SECONDS=60
GENERATION_TIMEOUT_SECONDS=80
RETRY_ATTEMPTS=2
RETRY_BASE_DELAY_SECONDS=0.25
RETRIEVAL_TOP_K=4
MINIMUM_RELEVANCE_SCORE=0.2
CHUNK_SIZE=900
CHUNK_OVERLAP=140
MAX_CONTEXT_CHARACTERS=8000
MAX_PROMPT_CHARACTERS=12000
MAX_PROMPT_UTF8_BYTES=18000
MAX_UPLOAD_BYTES=10000000
MAX_DOCUMENT_CHARACTERS=2000000
MAX_DOCUMENT_CHUNKS=2500
MAX_PDF_PAGES=500
MAX_REQUEST_BODY_BYTES=5000000
EMBEDDING_BATCH_SIZE=64
EMBEDDING_CONCURRENCY=2
RETRIEVAL_CONCURRENCY=4
INGESTION_CONCURRENCY=2
TEMPERATURE=0.2
TOP_P=0.9

# Optional local vLLM profile. HF_TOKEN is needed only for gated models.
# COMPOSE_PROFILES=local-llm
VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
VLLM_SERVED_MODEL_NAME=local-model
VLLM_DTYPE=auto
VLLM_MAX_MODEL_LEN=32768
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_PORT=8001
HF_TOKEN=

# W16 verification extension. Offline is a labeled simulation, not a language model.
AGENT_MODE=offline
AGENT_MODEL=gpt-4o-mini
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_API_KEY=
AGENT_MAX_STEPS=8
